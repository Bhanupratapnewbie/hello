# ---- Telegram (sole control gateway) ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Your numeric Telegram user id (the FIRST id allowed to control the agent).
# Find it by messaging @userinfobot on Telegram. Leave 0 to auto-claim the first
# account that sends /start.
TELEGRAM_ADMIN_CHAT_ID=123456789
# Optional shared invite token. When set, a trusted collaborator can become an
# additional admin by sending "/start <token>" to the bot (the owner keeps their
# own admin rights — the bot supports multiple admins). Leave empty to disable.
CC_ADMIN_CLAIM_TOKEN=

# ---- Default model provider (OpenAI-compatible Chat Completions API) ----
# The GLOBAL endpoint, used by any role that does not set its own override below.
# Recommended: point this at the cloud GPU box serving the uncensored open-weight
# BASE model (the brain). Run it full-precision (no quantization) via vLLM or
# Ollama (e.g. http://your-gpu-host:11434/v1). Any OpenAI-compatible endpoint works.
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama

# ---- Role -> model routing ----
# The query first hits the BASE/brain (planner): the latest-class, fully uncensored
# open-weight Qwen3 (abliterated), served full-precision, no quantization.
# Qwen3-32B is the largest dense Qwen3 (the only bigger one is the 235B MoE).
# Any latest uncensored Qwen or Gemma build is a drop-in replacement.
MODEL_PLANNER=huihui-ai/Qwen3-32B-abliterated
# Deep research / long-context reasoning -> a frontier trained model.
MODEL_REASONER=google/gemini-2.5-pro
# Pure code generation -> a top-tier coding model.
MODEL_CODER=anthropic/claude-opus-4.1
# Low-latency error parsing / corrective adjustments -> a fast frontier model.
MODEL_FIXER=google/gemini-2.5-flash

# ---- Per-role provider overrides (optional) ----
# Each role can target its own OpenAI-compatible endpoint + key. If left empty a
# role falls back to MODEL_BASE_URL / MODEL_API_KEY above. This is what keeps the
# uncensored open-weight BASE on your local GPU while the research/code/fix roles
# call cloud APIs. The simplest setup fronts Gemini + Claude with ONE OpenRouter
# key (https://openrouter.ai/api/v1). Planner intentionally has no override here
# so it uses the local GPU endpoint above.
MODEL_REASONER_BASE_URL=https://openrouter.ai/api/v1
MODEL_REASONER_API_KEY=sk-or-your-openrouter-key
MODEL_CODER_BASE_URL=https://openrouter.ai/api/v1
MODEL_CODER_API_KEY=sk-or-your-openrouter-key
MODEL_FIXER_BASE_URL=https://openrouter.ai/api/v1
MODEL_FIXER_API_KEY=sk-or-your-openrouter-key

# ---- Execution environment ----
# Working directory for the self-healing shell loop
CC_WORKDIR=./workspace
# Per-command timeout (seconds)
CC_COMMAND_TIMEOUT=300
# Max self-heal retries per failing command
CC_MAX_HEAL_ATTEMPTS=3

# ---- Progress supervisor (watchdog) ----
# Watches the whole task: caps total steps, detects repeating actions (loops),
# and periodically asks the base model whether the task is on the right path
# (continue / re-plan / ask the admin / abort).
CC_SUPERVISOR=true
# Hard ceiling on total executed steps for one request (runaway guard)
CC_MAX_TOTAL_STEPS=40
# Run an on-track check every N completed steps (0 disables periodic checks)
CC_SUPERVISOR_INTERVAL=4
# Identical consecutive actions that count as a stuck loop
CC_LOOP_THRESHOLD=3
# Max times the supervisor may re-plan the remaining work before asking the admin
CC_MAX_REPLANS=2
