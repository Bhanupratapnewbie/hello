# ---- Telegram (sole control gateway) ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Your numeric Telegram user id (the ONLY id allowed to control the agent).
# Find it by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_CHAT_ID=123456789

# ---- Model provider (OpenAI-compatible Chat Completions API) ----
# Point MODEL_BASE_URL at wherever you serve the models. For the recommended
# uncensored large-model setup, run a full-precision Qwen on a cloud GPU box via
# vLLM or Ollama and point here (e.g. http://localhost:11434/v1 for Ollama, or
# your vLLM server). Any OpenAI-compatible endpoint works (OpenRouter, Together, etc.).
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama

# ---- Role -> model routing (override with any model id your provider supports) ----
# Brain / macro-blueprint + routing. Default: the latest-class, fully uncensored
# open-weight Qwen3 (abliterated), served full-precision, no quantization.
# Qwen3-32B is the largest dense Qwen3 (the only bigger one is the 235B MoE).
# Any latest uncensored Qwen or Gemma build is a drop-in replacement.
MODEL_PLANNER=huihui-ai/Qwen3-32B-abliterated
# Deep, long-context reasoning / docs analysis / web research (same big uncensored model)
MODEL_REASONER=huihui-ai/Qwen3-32B-abliterated
# Pure code generation across languages (latest dedicated Qwen coder)
MODEL_CODER=qwen/qwen-2.5-coder-32b-instruct
# Low-latency error parsing / corrective adjustments (smaller fast latest-class model)
MODEL_FIXER=huihui-ai/Qwen3-8B-abliterated

# ---- Execution environment ----
# Working directory for the self-healing shell loop
CC_WORKDIR=./workspace
# Per-command timeout (seconds)
CC_COMMAND_TIMEOUT=300
# Max self-heal retries per failing command
CC_MAX_HEAL_ATTEMPTS=3
